# CureNova 2.0 Environment Configuration Template
# Environment mode: 'development', 'staging', or 'production'
ENVIRONMENT=development

# JWT Secret Signing Key (Required in production: minimum 32 characters, high-entropy)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
CURENOVA_JWT_SECRET=replace_with_a_secure_high_entropy_secret_min_32_chars

# Application Secret Key
CURENOVA_SECRET_KEY=replace_with_a_secure_app_secret_key_min_32_chars

# Database Connection URL (Supports SQLite for local dev or PostgreSQL for staging/prod)
# SQLite: sqlite:///./curenova.db
# PostgreSQL: postgresql+psycopg2://user:password@localhost:5432/curenova
DATABASE_URL=postgresql+psycopg2://postgres:your_password_here@127.0.0.1:5432/curenova

# Demo Dataset Seeding (Explicit development-only setting; strictly disabled in production)
ENABLE_DEMO_SEEDING=true

# Trusted Frontend Origins (Comma-separated origins, required in production without wildcards)
# e.g., https://app.curenova.com or http://localhost:5173 for local frontend dev
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional API Keys (Public endpoints work within default rate limits)
NCBI_API_KEY=your_ncbi_api_key_here
OPENFDA_API_KEY=your_openfda_api_key_here

# LLM Agent Configuration (Optional: defaults to safe deterministic fallback if disabled or unconfigured)
LLM_BACKEND_ENABLED=true
LLM_PROVIDER=openai
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-2.5-flash
LLM_API_KEY=your_llm_api_key_here
LLM_TIMEOUT_SECONDS=30.0
PROMPT_VERSION=v2.5.0